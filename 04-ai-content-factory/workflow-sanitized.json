                      "id":  "f50ceae3-89f6-4b06-9d07-ebc51e8badee",
                      "name":  "OpenRouter Chat Model1"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// 1. Пытаемся вытащить строки из ноды \"Get row(s) in sheet\"\nlet tableRows = [];\ntry {\n  tableRows = $(\"Get row(s) in sheet\").all();\n} catch (e) {\n  tableRows = [];\n}\n\nlet lastId = 0;\n\n// Ищем самый большой ID среди тех строк, что смогли получить\nif (tableRows \u0026\u0026 tableRows.length \u003e 0) {\n  const ids = tableRows\n    .map(row =\u003e parseInt(row.json[\"ID\"]))\n    .filter(id =\u003e !isNaN(id));\n    \n  if (ids.length \u003e 0) {\n    lastId = Math.max(...ids);\n  }\n}\n\n// 2. Получаем текст от ИИ и очищаем его от маркдауна\nconst aiResponse = $input.item.json.text;\nif (!aiResponse) {\n  throw new Error(\"Нода ИИ вернула пустой текст!\");\n}\n\nconst cleanJsonText = aiResponse.replace(/```json|```/g, \u0027\u0027).trim();\n\nlet jokesArray = [];\ntry {\n  jokesArray = JSON.parse(cleanJsonText);\n} catch (e) {\n  throw new Error(\"Клод прислал обрезанный или кривой JSON. Проверь параметр \u0027Max Tokens\u0027 в ноде ИИ и увеличь его до 4000+! Ошибка: \" + e.message);\n}\n\n// 3. Форматируем анекдоты, поддерживая оба варианта ключей (text и Анекдот)\nreturn jokesArray.map((jokeItem, index) =\u003e {\n  // Забираем текст шутки, независимо от того, как Клод назвал ключ\n  const jokeText = jokeItem.Анекдот || jokeItem.text || \"\";\n  \n  return {\n    \"json\": {\n      \"ID\": lastId + index + 1,\n      \"Анекдот\": jokeText,\n      \"Статус\": \"new\"\n    }\n  };\n});"
                                     },
