                  {
                      "parameters":  {
                                         "jsCode":  "let count = 0;\n\n// Проходимся по всем входящим элементам\nfor (const item of $input.all()) {\n  // Проверяем, равен ли статус \"new\"\n  if (item.json[\"Статус\"] === \"new\") {\n    count++;\n  }\n}\n\n// Возвращаем результат в виде объекта\nreturn [\n  {\n    \"json\": {\n      \"new_status_count\": count\n    }\n  }\n];"
                                     },
                      "id":  "dad0da18-9f99-4069-9671-9259432dba52",
