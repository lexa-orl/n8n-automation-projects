                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "let out = \u0027🔥 TOP n8n GitHub workflows\\n\\n\u0027;\nitems.forEach((i, idx) =\u003e {\n  out += `${idx+1}. ${i.json.name}\\n`;\n  out += `⭐ ${i.json.stars}\\n`;\n  out += `${i.json.description || \u0027\u0027}\\n`;\n  out += `${i.json.url}\\n\\n`;\n});\nreturn [{ text: out }];"
                                     },
