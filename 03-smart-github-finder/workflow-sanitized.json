                  {
                      "parameters":  {
                                         "jsCode":  "const r = JSON.parse($json.text);\nreturn [{\n  name: $json.name,\n  url: $json.html_url,\n  description: $json.description,\n  stars: $json.stargazers_count,\n  score: r.score,\n  reason: r.reason\n}];"
